<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <AssemblyName>LethalCraft</AssemblyName>
    <Version>0.2.3</Version>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Lethal Company</GameDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(GameDir)\BepInEx</BepInExDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameDir)\Lethal Company_Data\Managed\Unity*.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameDir)\Lethal Company_Data\Managed\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(GameDir)\Lethal Company_Data\Managed\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="Facepunch.Steamworks.Win64" HintPath="$(GameDir)\Lethal Company_Data\Managed\Facepunch.Steamworks.Win64.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExDir)\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExDir)\core\0Harmony.dll" Private="false" />
  </ItemGroup>
</Project>
